---
import BaseLayout from "../layouts/BaseLayout.astro";

const structuredData = {
  "@context": "https://schema.org",
  "@type": "ExercisePhysicalActivity",
  name: "Bransky Fitness",
  url: "https://www.branskyfitness.com/",
  description: "Personal training studio in Pleasanton, CA led by NASM-certified trainer Mark Bransky.",
  image: "https://www.branskyfitness.com/images/hero-squat-alt.jpg",
  address: {
    "@type": "PostalAddress",
    streetAddress: "1040 Serpentine Lane, Suites 203/204",
    addressLocality: "Pleasanton",
    addressRegion: "CA",
    postalCode: "94566",
    addressCountry: "US",
  },
  founder: {
    "@type": "Person",
    name: "Mark Bransky",
    jobTitle: "Personal Trainer, NASM-Certified",
  },
  openingHours: "Mo-Sa",
  email: "Mark@branskyfitness.com",
  sameAs: [
    "https://www.linkedin.com/in/mark-bransky-19b2754/",
    "https://www.instagram.com/trainertrainerguy",
  ],
};
---
<BaseLayout
  title="Bransky Fitness | Personal Trainer in Pleasanton, CA"
  description="Expert personal training in the Tri-Valley Area. Mark Bransky, NASM-certified trainer with nearly 20 years of experience, builds programs around real movement assessments in a private Pleasanton studio."
  path="/"
  ogDescription="Expert personal training in the Tri-Valley Area, built around real movement assessments, not cookie-cutter programs."
  ogImage="https://www.branskyfitness.com/images/hero-squat-alt.jpg"
  activeNav="home"
  structuredData={structuredData}
>

  <section class="hero facets">
    <div class="wrap">
      <div class="hero-copy">
        <p class="hero-kicker">Expert Personal Training Serving the Tri-Valley Area</p>
        <h1>Move better. Feel stronger. Stay consistent.</h1>
        <p class="hero-lede">Hi, I'm Mark Bransky. My years of experience in personal training have given me the knowledge and expertise to help you work toward your goals. Every program is curated to your individual needs, whether you're new to exercise or getting back in shape.</p>
        <div class="hero-actions">
          <a class="btn btn-coral" href="/contact/">Let's Go!</a>
          <a class="btn btn-ghost" href="/training/">See how training works</a>
        </div>
      </div>

      <figure class="hero-photo">
        <img src="/images/hero-squat-alt.jpg" alt="Mark Bransky coaching a client through a bodyweight squat in his private Pleasanton training studio" width="1200" height="871" loading="eager">
      </figure>

      <div class="stat-row">
        <div class="stat"><span class="stat-num">20</span><span class="stat-label">years training clients</span></div>
        <div class="stat"><span class="stat-num">1,000+</span><span class="stat-label">trainers certified through NASM</span></div>
        <div class="stat"><span class="stat-num">1</span><span class="stat-label">private studio, no crowds</span></div>
      </div>
    </div>
  </section>

  <section class="section-dark facets-dark" aria-labelledby="expect-heading">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow" style="font-weight:600; margin-bottom:0.5rem;">What to expect</p>
        <h2 id="expect-heading">A process, not a workout playlist</h2>
      </div>

      <div class="process-row">
        <figure class="process-photo">
          <img src="/images/hero-squat.jpg" alt="Mark Bransky observing a client's squat form on turf flooring in the studio" width="1600" height="942" loading="lazy">
        </figure>
        <div class="process-copy">
          <p class="process-eyebrow">Assess your starting point</p>
          <h3>We begin with a conversation, then a movement assessment</h3>
          <p>We start with a sit-down discussion about your goals, training history, injury history, and lifestyle. Then we assess your movement quality to identify imbalances and design a program that's actually safe and effective for your body, not a generic template.</p>
        </div>
      </div>

      <div class="process-row reverse">
        <figure class="process-photo">
          <img src="/images/training-lunge.jpg" alt="Mark Bransky coaching a client through a kettlebell lunge in the studio" width="2000" height="1400" loading="lazy">
        </figure>
        <div class="process-copy">
          <p class="process-eyebrow">Your program</p>
          <h3>Built around you, adjusted as you go</h3>
          <p>I build a customized program and work with you to develop comfort and confidence with it. Some clients prefer to train with me indefinitely; others want to become functionally independent. Either way, I never ask for long commitments. I have to keep earning your business every step of the way.</p>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="programs-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="programs-heading">Programs</h2>
        <p class="lede">Four ways clients work with Mark, from one-on-one correction to mentoring the next generation of trainers.</p>
      </div>
      <div class="program-grid">
        <div class="program-card">
          <h3>Functional movement</h3>
          <p>Rebuild the fundamental patterns: squat, hinge, push, pull, and carry, so you move without compensation or pain.</p>
        </div>
        <div class="program-card">
          <h3>Strength &amp; conditioning</h3>
          <p>Structured programming that builds real strength and capacity, adjusted as you progress rather than left on autopilot.</p>
        </div>
        <div class="program-card">
          <h3>Weight management</h3>
          <p>Training and habit coaching built around sustainable change, not a six-week sprint you can't maintain.</p>
        </div>
        <div class="program-card">
          <h3>Trainer mentorship &amp; workshops</h3>
          <p>One-on-one mentoring and workshops for personal trainers, drawing on Mark's work certifying over 1,000 trainers through NASM.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="facets" aria-labelledby="testimonials-heading">
    <div class="wrap">
      <div class="section-head">
        <h2 id="testimonials-heading">From clients</h2>
        <p class="lede">Recovering from surgery, correcting imbalances, or just staying consistent, in their words.</p>
      </div>

      <div class="testimonial-grid">
        <blockquote class="testimonial">
          <p>"I had a lot of difficulty getting back to my workouts after shoulder surgery. My PT gave me standard exercises and didn't really give me the attention I needed. Mark had me do a couple of movement assessments and told me what the problem was. His workouts were based on the assessments, and it made me feel sooooo much better. He always takes the time to tell me the 'why' behind the exercises which makes me feel more confident."</p>
          <cite>Carolina R.</cite>
        </blockquote>
        <blockquote class="testimonial">
          <p>"One of the best decisions I made was going to Mark. I had developed shoulder and back pain from my workouts, and other trainers I worked with were not helpful. Mark was able to tell me about my muscle imbalances and simple ways to correct my issue. It was amazing. Out of pain that day, and my lifts went up. We've accomplished so much over the last few years."</p>
          <cite>Peter D.</cite>
        </blockquote>
      </div>

      <div class="testimonial-grid compact">
        <blockquote class="testimonial">
          <p>"He knows the science about the body and exercise, which helped me understand the 'why' behind what I was doing. I couldn't have been so consistent without him."</p>
          <cite>Carolyn A.</cite>
        </blockquote>
        <blockquote class="testimonial">
          <p>"His clear explanations, creative and effective workouts, and comfortable personality create an amazing training experience."</p>
          <cite>Emily B.</cite>
        </blockquote>
        <blockquote class="testimonial">
          <p>"He discovered weaknesses in my back, and so we changed the whole program. He's worth a shot!"</p>
          <cite>Neil R.</cite>
        </blockquote>
      </div>

      <p style="text-align:center; margin-top: var(--space-4);"><a href="/testimonials/">Read every client story &rarr;</a></p>

      <div class="trust-strip">
        <img src="/images/award-badge.jpg" alt="Best of BusinessRate 2025 award badge for Bransky Fitness, Personal Trainer in Pleasanton, CA">
        <p>Rated among the best personal trainers in Pleasanton, CA (BusinessRate 2025).</p>
      </div>
    </div>
  </section>

  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="wrap">
      <h2 id="cta-heading">Start getting results today.</h2>
      <a class="btn btn-primary" href="/contact/">Let's Go!</a>
    </div>
  </section>

</BaseLayout>
